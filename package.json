{
  "name": "dsh-log-guardian",
  "version": "0.1.0",
  "description": "LogGuardian — a real-time log security sentinel for DeepSeek Harness (DSH). Tails DSH logs incrementally and raises dual-channel alerts the moment dangerous calls (cordis_define / cordis_run / subprocess …) appear, defending against prompt-injection → dynamic-plugin → RCE attack chains.",
  "type": "module",
  "main": "lib/index.js",
  "exports": {
    ".": {
      "default": "./lib/index.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "lib",
    "cordis.patch.yml"
  ],
  "scripts": {
    "test": "node test/smoke.mjs && node test/integration.mjs",
    "prepublishOnly": "npm test"
  },
  "keywords": [
    "dsh",
    "deepseek",
    "harness",
    "cordis",
    "plugin",
    "security",
    "log-monitor",
    "prompt-injection",
    "rce",
    "guardian"
  ],
  "author": "miaoluoxue",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/miaoluoxue/dsh-log-guardian.git"
  },
  "homepage": "https://github.com/miaoluoxue/dsh-log-guardian#readme",
  "bugs": {
    "url": "https://github.com/miaoluoxue/dsh-log-guardian/issues"
  },
  "engines": {
    "node": ">=18"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "peerDependencies": {
    "@deepseek-ai/schemastery": "^3.18.0"
  },
  "peerDependenciesMeta": {
    "@deepseek-ai/schemastery": {
      "optional": true
    }
  }
}
